# M1 bot settings. Copy this file to .env.m1 and fill it in (.env.m1 is
# gitignored, never commit it). The M5 bot keeps using .env.
#
# The M1 bot needs its OWN MT5 account and its OWN MetaTrader 5 install,
# so it never sees the M5 bot's trades (one trade at a time and the daily
# loss limit both read everything on the account).

# ---- MT5: the M1 demo account ----
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
# The SECOND MetaTrader 5 install (not the one the M5 bot uses), e.g.
MT5_PATH=C:\Program Files\MetaTrader 5 M1\terminal64.exe

# ---- Supabase: the "M1 bot" project ----
SUPABASE_URL=https://nvkwnpesedzwnxewuczn.supabase.co
# Project Settings -> API Keys -> service_role (secret). Keep it private.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
