# Copy to .env.local for local testing. On Vercel, add the same names under
# Project Settings -> Environment Variables. None of these reach the phone:
# the dashboard's server uses them, the browser only sees the pages.

# 4 digit PIN for the login screen.
DASHBOARD_PIN=
# Any long random text (40+ characters). Signs the "remember me for 30
# days" cookie. Changing it (or the PIN) logs every phone out.
SESSION_SECRET=

# M5 bot's Supabase project (Settings -> API): Project URL and the
# service_role key (the secret one, NOT anon).
M5_SUPABASE_URL=
M5_SUPABASE_SERVICE_ROLE_KEY=

# M1 bot's Supabase project, same two values.
M1_SUPABASE_URL=
M1_SUPABASE_SERVICE_ROLE_KEY=
